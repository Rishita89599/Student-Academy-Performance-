# R Markdown

This is an R Markdown document for analysis of student academic performance.

```{r}
student_data <- data.frame(
  Student_ID = c(
    101,102,103,104,105,106,107,108,109,110,
    111,112,113,114,115,116,117,118,119,120,
    121,122,123,124,125,126,127,128,129,130
  ),
  
  Gender = c(
    "Male","Female","Male","Female","Male","Female","Male","Female","Male","Female",
    "Male","Female","Male","Female","Male","Female","Male","Female","Male","Female",
    "Male","Female","Male","Female","Male","Female","Male","Female","Male","Female"
  ),
  
  Attendance = c(
    85,92,65,88,72,95,58,81,76,90,
    68,87,74,93,61,84,79,89,70,96,
    83,77,91,69,86,94,63,80,75,88
  ),
  
  Study_Hours = c(
    3,5,2,4,3,6,1,4,3,5,
    2,4,3,6,2,4,3,5,2,6,
    4,3,5,2,4,5,1,3,3,4
  ),
  
  Assignment_Score = c(
    78,88,60,82,70,92,52,75,68,85,
    62,80,72,90,55,78,74,86,65,94,
    81,73,89,59,83,91,50,71,67,79
  ),
  
  Exam_Marks = c(
    82,91,55,85,68,94,45,79,72,89,
    58,83,70,92,52,80,76,87,63,96,
    84,74,90,57,86,93,48,73,69,81
  ),
  
  Result = c(
    "Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass",
    "Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass",
    "Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass","Pass"
  )
)

student_data
```

